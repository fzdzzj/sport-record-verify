<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sportverify</groupId>
        <artifactId>sport-verify-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- mapmatch-service：道路拓扑匹配微服务（第 6 个服务，服务数 5→6，见 ADR-0006）
         职责：承载真实 OSM 路网（PostGIS）+ 最近边投影匹配算法，暴露 POST /match；
         verify-service 的 R5 离路规则经 MapMatchApi(Feign) 远程调用本服务计算偏离路网比例 -->
    <artifactId>sport-verify-mapmatch-service</artifactId>
    <name>sport-verify-mapmatch-service</name>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.sportverify</groupId>
            <artifactId>sport-verify-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sportverify</groupId>
            <artifactId>sport-verify-api</artifactId>
        </dependency>

        <!-- Spring Boot / Cloud 基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Bean Validation 实现（hibernate-validator）：@Valid + DTO 注解在控制器层触发校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标导出（可观测性，见 ADR-0003）：版本由父 pom BOM 管理 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- 数据访问：JdbcTemplate + PostGIS。
             为何不用 MyBatis-Plus：路网表核心字段是 geometry 空间类型，匹配查询依赖
             ST_DWithin/ST_AsText 等空间函数（走 GIST 索引），ORM 实体映射收益低，
             直接 JdbcTemplate 手写空间 SQL 更透明（见 ADR-0006） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- PostgreSQL JDBC 驱动：PostGIS 是 PostgreSQL 扩展，用 PG 协议驱动连接 -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- 打包：spring-boot repackage（父 pom 非 spring-boot-starter-parent，需显式绑定到 package 阶段） -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- checkstyle 3.6.0（2024-06 稳定版，内置 checkstyle 9.3——与基准计数同引擎）
                 规则集与 leaderboard-service 现行 src/main/resources/checkstyle.xml 逐字节一致
                 （sha256 289abf8d…c2e076，262 行），版本/配置项与 leaderboard-service pom 逐项对齐，
                 仅 configLocation 指向本模块同名路径。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>src/main/resources/checkstyle.xml</configLocation>
                    <!-- 规则集含中文注释，显式锁定读取编码，避免随平台编码漂移 -->
                    <inputEncoding>UTF-8</inputEncoding>
                    <!-- 只检查主源码：测试源码不在本任务白名单内，纳入会引入无法消除的存量违规 -->
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                    <!-- 违规必须逐条打印进构建日志，便于审计（不静默吞掉计数） -->
                    <consoleOutput>true</consoleOutput>
                    <logViolationsToConsole>true</logViolationsToConsole>
                    <logViolationCountToConsole>true</logViolationCountToConsole>
                </configuration>
            </plugin>

            <!-- PMD 3.28.0（内置 PMD 7.17.0）：规则集/口径与 leaderboard-service pom 逐项一致——
                 显式引用插件内置默认规则集 rulesets/java/maven-pmd-plugin-default.xml，
                 includeTests=false（口径与 checkstyle 一致），failurePriority=3、
                 printFailingErrors=true（失败项逐条打印，不静默吞计数）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <rulesets>
                        <ruleset>rulesets/java/maven-pmd-plugin-default.xml</ruleset>
                    </rulesets>
                    <includeTests>false</includeTests>
                    <failurePriority>3</failurePriority>
                    <printFailingErrors>true</printFailingErrors>
                </configuration>
            </plugin>

            <!-- SpotBugs 4.9.8.5：分析口径与阈值与 leaderboard-service pom 逐项一致
                 （failThreshold=High、includeTests=false）。本模块仅有 EI_EXPOSE_REP2（Medium，
                 构造器注入字段的经典误报，与 leaderboard-service 同源同判），High 级留作红线。 -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.8.5</version>
                <configuration>
                    <failThreshold>High</failThreshold>
                    <includeTests>false</includeTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
