# 本地开发环境变量样例：复制为仓库根 .env 后按本机情况改（.env 与 .env.* 均在忽略清单内，不入库）
# docker compose 自动读取仓库根 .env；Java 服务侧要生效需先导出：set -a; . ./.env; set +a
#
# 口令类变量只在数据卷「首次初始化」时生效：已有数据卷不会随之改密，
# 换口令需 docker compose down -v 重建卷，或在库内 ALTER USER。
# 下面全是占位值，仅限本地演示；部署前必须换成强随机口令并走密钥管理，切勿提交进仓库。

# ===== 宿主机端口覆盖（本机 3306/5432 已被占用时改这里；compose 与四个服务的数据源均已参数化）=====
MYSQL_PORT=3306
POSTGRES_PORT=5432

# ===== 中间件口令占位 =====
MYSQL_ROOT_PASSWORD=root
# record-service 分片数据源（sharding.yaml）读的是这个变量名，必须与 MYSQL_ROOT_PASSWORD 保持一致
MYSQL_PASSWORD=root
POSTGRES_PASSWORD=postgres

# ===== Grafana 控制台账号（生产改走 SSO / 密钥管理）=====
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===== 真库端到端测试（bash scripts/verify/mvn-verify.sh --it）=====
# 指向 scratch 准备库，不要指向开发库；三个变量缺任一，该测试即被 assume 跳过（跳过不得计入通过）。
# 准备库的一条命令与建库步骤见 README「真库端到端测试（--it）」一节。
TASK108_IT_URL=jdbc:mysql://127.0.0.1:3309/task108_it?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
TASK108_IT_USER=root
TASK108_IT_PASSWORD=probe
