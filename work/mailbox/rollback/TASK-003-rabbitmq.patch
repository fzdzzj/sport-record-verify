+package com.sportverify.leaderboard.config;
+
+import org.springframework.amqp.core.*;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+
+/**
+ * RabbitMQ 配置：榜单更新队列（异步幂等 + 死信处理）
+ */
+@Configuration
+public class RabbitMQConfig {
+
+    /** 榜单更新队列 */
+    private static final String QUEUE = "leaderboard-update-queue";
+    
+    /** 死信交换机 */
+    private static final String DLX_EXCHANGE = "leaderboard-update-dlx-exchange";
+    
+    /** 死信队列 */
+    private static final String DLX_QUEUE = "leaderboard-update-dlx-queue";
+    
+    /** TTL（毫秒） */
+    private static final long MESSAGE_TTL_MS = 60000;
+    
+    /** 最大重试次数 */
+    private static final int MAX_RETRY = 3;
+
+    @Value("${spring.rabbitmq.host:localhost}")
+    private String host;
+
+    @Value("${spring.rabbitmq.port:5672}")
+    private int port;
+
+    @Value("${spring.rabbitmq.username:guest}")
+    private String username;
+
+    @Value("${spring.rabbitmq.password:guest}")
+    private String password;
+
+    /**
+     * 创建主队列（带死信交换器）
+     */
+    @Bean
+    public Queue mainQueue() {
+        return QueueBuilder.durable(QUEUE)
+                .withArgument("x-dead-letter-exchange", DLX_EXCHANGE)
+                .withArgument("x-message-ttl", MESSAGE_TTL_MS)
+                .withArgument("x-max-length", MAX_RETRY)
+                .build();
+    }
+
+    /**
+     * 创建死信交换机
+     */
+    @Bean
+    public DirectExchange dlxExchange() {
+        return new DirectExchange(DLX_EXCHANGE, true, false);
+    }
+
+    /**
+     * 创建死信队列
+     */
+    @Bean
+    public Queue dlxQueue() {
+        return QueueBuilder.durable(DLX_QUEUE).build();
+    }
+
+    /**
+     * 绑定死信队列到死信交换机
+     */
+    @Bean
+    public Binding dlxBinding() {
+        return BindingBuilder.bind(dlxQueue()).to(dlxExchange()).with(DLX_QUEUE);
+    }
+
+    /**
+     * 绑定主队列到死信交换机（消息失败后路由到死信队列）
+     */
+    @Bean
+    public Binding mainBinding() {
+        return BindingBuilder.bind(mainQueue()).to(dlxExchange()).with(QUEUE);
+    }
+}
