@@ -0,0 +1,172 @@
+package com.sportverify.leaderboard.consumer;
+
+import ch.qos.logback.classic.Logger;
+import ch.qos.logback.classic.spi.ILoggingEvent;
+import ch.qos.logback.core.read.ListAppender;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.sportverify.leaderboard.event.LeaderboardUpdateEvent;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+import org.redisson.api.RAtomicLong;
+import org.redisson.api.RBucket;
+import org.redisson.api.RedissonClient;
+import org.slf4j.LoggerFactory;
+import org.springframework.amqp.core.Message;
+import org.springframework.amqp.core.MessageProperties;
+
+import java.time.Duration;
+import java.time.Instant;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+/**
+ * LeaderboardUpdateConsumer 单元测试：幂等去重、重复跳过、失败重投计数、死信阈值分支。
+ *
+ * <p>processUpdate 目前只写日志、未接入 LeaderboardService（见 handoff.md），
+ * 因此「是否进入处理分支」唯一可观测信号是日志；这里用 Logback ListAppender 捕获
+ * 消费者自身 logger 的输出，配合 Mockito 交互断言共同锁定行为。</p>
+ */
+class LeaderboardUpdateConsumerTest {
+
+    /** 去重键前缀，须与 LeaderboardUpdateConsumer#checkAndSetDedupKey 保持一致 */
+    private static final String DEDUP_KEY_PREFIX = "leaderboard:update:";
+    /** 重试计数键前缀，须与 LeaderboardUpdateConsumer#isRetryExceeded 保持一致 */
+    private static final String RETRY_KEY_PREFIX = "leaderboard:retry:";
+    /** processUpdate 三个分支的日志共同前缀，用于判断「是否进入了处理分支」 */
+    private static final String PROCESSING_LOG_MARKER = "执行榜单";
+
+    private LeaderboardUpdateConsumer consumer;
+    private AutoCloseable mocks;
+    private Logger consumerLogger;
+    private ListAppender<ILoggingEvent> logAppender;
+
+    @Mock
+    private ObjectMapper objectMapper;
+
+    @Mock
+    private RedissonClient redissonClient;
+
+    @Mock
+    private RBucket<String> dedupBucket;
+
+    @Mock
+    private RAtomicLong retryCounter;
+
+    @Mock
+    private Message message;
+
+    @Mock
+    private MessageProperties messageProperties;
+
+    @BeforeEach
+    void setUp() {
+        mocks = MockitoAnnotations.openMocks(this);
+        consumer = new LeaderboardUpdateConsumer(objectMapper, redissonClient);
+
+        when(message.getMessageProperties()).thenReturn(messageProperties);
+        when(messageProperties.getCorrelationId()).thenReturn("test-trace-id");
+
+        logAppender = new ListAppender<>();
+        logAppender.start();
+        consumerLogger = (Logger) LoggerFactory.getLogger(LeaderboardUpdateConsumer.class);
+        consumerLogger.addAppender(logAppender);
+    }
+
+    @AfterEach
+    void tearDown() throws Exception {
+        consumerLogger.detachAppender(logAppender);
+        logAppender.stop();
+        mocks.close();
+    }
+
+    @Test
+    void firstTimeEventWritesDedupKeyAndRunsProcessing() {
+        LeaderboardUpdateEvent event = event("evt-first", "ADD");
+        when(redissonClient.<String>getBucket(DEDUP_KEY_PREFIX + "evt-first")).thenReturn(dedupBucket);
+        when(dedupBucket.setIfAbsent(eq("1"), any(Duration.class))).thenReturn(true);
+
+        assertDoesNotThrow(() -> consumer.consume(message, event));
+
+        verify(redissonClient, times(1)).getBucket(DEDUP_KEY_PREFIX + "evt-first");
+        verify(dedupBucket, times(1)).setIfAbsent(eq("1"), eq(Duration.ofHours(24)));
+        verify(redissonClient, never()).getAtomicLong(anyString());
+        assertTrue(hasLoggedContaining("执行榜单添加"), "首次事件应进入处理分支");
+    }
+
+    @Test
+    void duplicateEventIsSkippedWithoutProcessing() {
+        LeaderboardUpdateEvent event = event("evt-dup", "ADD");
+        when(redissonClient.<String>getBucket(DEDUP_KEY_PREFIX + "evt-dup")).thenReturn(dedupBucket);
+        when(dedupBucket.setIfAbsent(eq("1"), any(Duration.class))).thenReturn(false);
+
+        assertDoesNotThrow(() -> consumer.consume(message, event));
+
+        // 只做了去重探测，未进入后续处理，也未触碰重试计数
+        verify(dedupBucket, times(1)).setIfAbsent(eq("1"), eq(Duration.ofHours(24)));
+        verify(redissonClient, never()).getAtomicLong(anyString());
+        assertTrue(hasLoggedContaining("重复榜单更新事件已消费过"), "重复事件应命中跳过分支");
+        assertFalse(hasLoggedContaining(PROCESSING_LOG_MARKER), "重复事件不得进入处理分支");
+    }
+
+    @Test
+    void processingFailureIsRethrownAfterCountingRetry() {
+        LeaderboardUpdateEvent event = event("evt-fail", null);
+        when(redissonClient.<String>getBucket(DEDUP_KEY_PREFIX + "evt-fail")).thenReturn(dedupBucket);
+        when(dedupBucket.setIfAbsent(eq("1"), any(Duration.class))).thenReturn(true);
+        when(redissonClient.getAtomicLong(RETRY_KEY_PREFIX + "evt-fail")).thenReturn(retryCounter);
+        when(retryCounter.incrementAndGet()).thenReturn(1L);
+
+        // operation=null 时 processUpdate 的 switch 抛 NPE：这是桩体唯一可控的失败注入点
+        assertThrows(NullPointerException.class, () -> consumer.consume(message, event));
+
+        verify(redissonClient, times(1)).getAtomicLong(RETRY_KEY_PREFIX + "evt-fail");
+        verify(retryCounter, times(1)).incrementAndGet();
+        assertFalse(hasLoggedContaining(PROCESSING_LOG_MARKER), "处理应在 switch 处失败，未产出任何处理分支日志");
+    }
+
+    @Test
+    void retryOverThresholdStillRethrowsForDeadLetterRouting() {
+        LeaderboardUpdateEvent event = event("evt-dlq", null);
+        when(redissonClient.<String>getBucket(DEDUP_KEY_PREFIX + "evt-dlq")).thenReturn(dedupBucket);
+        when(dedupBucket.setIfAbsent(eq("1"), any(Duration.class))).thenReturn(true);
+        when(redissonClient.getAtomicLong(RETRY_KEY_PREFIX + "evt-dlq")).thenReturn(retryCounter);
+        when(retryCounter.incrementAndGet()).thenReturn(4L);
+
+        assertThrows(NullPointerException.class, () -> consumer.consume(message, event));
+
+        verify(retryCounter, times(1)).incrementAndGet();
+        assertTrue(hasLoggedContaining("进入死信队列"), "重试超阈值应命中死信分支");
+    }
+
+    private LeaderboardUpdateEvent event(String eventId, String operation) {
+        return LeaderboardUpdateEvent.builder()
+                .eventId(eventId)
+                .userId(1L)
+                .sportType("RUNNING")
+                .leaderboardType("total")
+                .operation(operation)
+                .pointsDelta(100L)
+                .recordId(456L)
+                .timestamp(Instant.now())
+                .build();
+    }
+
+    private boolean hasLoggedContaining(String fragment) {
+        return logAppender.list.stream()
+                .map(ILoggingEvent::getFormattedMessage)
+                .anyMatch(msg -> msg.contains(fragment));
+    }
+}
