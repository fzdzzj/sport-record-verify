+package com.sportverify.leaderboard.consumer;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.sportverify.leaderboard.event.LeaderboardUpdateEvent;
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.redisson.api.RBucket;
+import org.redisson.api.RedissonClient;
+import org.springframework.amqp.core.Message;
+import org.springframework.amqp.rabbit.annotation.RabbitListener;
+import org.springframework.messaging.handler.annotation.Payload;
+import org.springframework.stereotype.Component;
+
+import java.time.Duration;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * 榜单更新消费者（RabbitMQ）
+ * 
+ * <p>处理异步榜单更新消息，实现幂等性和死信处理：
+ * <ul>
+ *   <li>幂等：Redis SETNX（eventId，24h TTL）去重</li>
+ *   <li>失败重试：返回 RECONSUME_LATER 交由 RabbitMQ 重投</li>
+ *   <li>死信：超过最大重试次数进入 DLQ</li>
+ * </ul>
+ */
+@Slf4j
+@Component
+@RequiredArgsConstructor
+public class LeaderboardUpdateConsumer {
+
+    private final ObjectMapper objectMapper;
+    private final RedissonClient redissonClient;
+
+    /** 去重键 TTL（小时） */
+    private static final long DEDUP_TTL_HOURS = 24;
+    
+    /** 最大重试次数 */
+    private static final int MAX_RETRY = 3;
+
+    /**
+     * 监听主队列
+     */
+    @RabbitListener(queues = "leaderboard-update-queue")
+    public void consume(Message message, @Payload LeaderboardUpdateEvent event) {
+        String correlationId = message.getMessageProperties().getCorrelationId();
+        
+        try {
+            log.info("收到榜单更新事件：eventId={}, userId={}, sportType={}, operation={}, correlationId={}",
+                    event.getEventId(), event.getUserId(), event.getSportType(), event.getOperation(), correlationId);
+
+            // 1. 幂等检查
+            if (!checkAndSetDedupKey(event.getEventId())) {
+                log.info("重复榜单更新事件已消费过，跳过：eventId={}", event.getEventId());
+                return;
+            }
+
+            // 2. 处理榜单更新
+            processUpdate(event);
+
+        } catch (Exception e) {
+            log.error("榜单更新事件处理失败：eventId={}, correlationId={}", event.getEventId(), correlationId, e);
+            
+            // 检查是否超过重试次数
+            if (isRetryExceeded(event.getEventId())) {
+                log.error("榜单更新事件重试超阈值，进入死信队列：eventId={}", event.getEventId());
+                throw e; // 抛出异常让 RabbitMQ 路由到死信队列
+            }
+            
+            // 未超阈值，抛异常触发重投
+            throw e;
+        }
+    }
+
+    /**
+     * 处理榜单更新逻辑
+     */
+    private void processUpdate(LeaderboardUpdateEvent event) {
+        // TODO: 实际业务逻辑由 LeaderboardService 处理
+        // 这里仅做示例演示
+        switch (event.getOperation()) {
+            case "ADD":
+                log.info("执行榜单添加：userId={}, pointsDelta={}", event.getUserId(), event.getPointsDelta());
+                break;
+            case "REMOVE":
+                log.info("执行榜单移除：userId={}", event.getUserId());
+                break;
+            case "UPDATE":
+                log.info("执行榜单更新：userId={}, pointsDelta={}", event.getUserId(), event.getPointsDelta());
+                break;
+            default:
+                log.warn("未知操作类型：{}", event.getOperation());
+        }
+    }
+
+    /**
+     * 幂等检查：SETNX
+     * @return true 表示首次处理，false 表示重复
+     */
+    private boolean checkAndSetDedupKey(String eventId) {
+        String key = "leaderboard:update:" + eventId;
+        RBucket<String> bucket = redissonClient.getBucket(key);
+        boolean success = bucket.setIfAbsent("1", Duration.ofHours(DEDUP_TTL_HOURS));
+        return success;
+    }
+
+    /**
+     * 删除去重键（用于失败场景允许重投）
+     */
+    private void deleteDedupKey(String eventId) {
+        String key = "leaderboard:update:" + eventId;
+        try {
+            redissonClient.getBucket(key).delete();
+        } catch (Exception e) {
+            log.warn("删除去重键失败：eventId={}", eventId, e);
+        }
+    }
+
+    /**
+     * 重试计数自增并判断是否超过阈值
+     */
+    private boolean isRetryExceeded(String eventId) {
+        String key = "leaderboard:retry:" + eventId;
+        try {
+            var atomicLong = redissonClient.getAtomicLong(key);
+            long count = atomicLong.incrementAndGet();
+            return count > MAX_RETRY;
+        } catch (Exception e) {
+            log.warn("重试计数失败：eventId={}", eventId, e);
+            return false;
+        }
+    }
+}
