+package com.sportverify.leaderboard.consumer;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.sportverify.leaderboard.event.LeaderboardUpdateEvent;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+import org.redisson.api.RBucket;
+import org.redisson.api.RedissonClient;
+import org.springframework.amqp.core.Message;
+
+import java.time.Instant;
+
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+/**
+ * LeaderboardUpdateConsumer 测试
+ */
+class LeaderboardUpdateConsumerTest {
+
+    private LeaderboardUpdateConsumer consumer;
+    
+    @Mock
+    private ObjectMapper objectMapper;
+    
+    @Mock
+    private RedissonClient redissonClient;
+    
+    @Mock
+    private RBucket<String> bucket;
+    
+    @Mock
+    private Message message;
+
+    @BeforeEach
+    void setUp() {
+        MockitoAnnotations.openMocks(this);
+        consumer = new LeaderboardUpdateConsumer(objectMapper, redissonClient);
+        
+        // Mock message properties
+        when(message.getMessageProperties().getReceivedRoutingKey()).thenReturn("test-trace-id");
+    }
+
+    @Test
+    void testConsumeSuccessfulUpdate() throws Exception {
+        // Arrange
+        LeaderboardUpdateEvent event = LeaderboardUpdateEvent.builder()
+                .eventId("test-event-123")
+                .userId(1L)
+                .sportType("RUNNING")
+                .leaderboardType("total")
+                .operation("ADD")
+                .pointsDelta(100L)
+                .recordId(456L)
+                .timestamp(Instant.now())
+                .build();
+        
+        when(redissonClient.getBucket(anyString())).thenReturn(bucket);
+        when(bucket.setIfAbsent(any(), any())).thenReturn(true);
+        
+        // Act & Assert - should not throw exception
+        assertDoesNotThrow(() -> consumer.consume(message, event));
+        
+        // Verify idempotency key was set
+        verify(redissonClient).getBucket(eq("leaderboard:update:test-event-123"));
+        verify(bucket).setIfAbsent(eq("1"), any());
+    }
+
+    @Test
+    void testConsumeDuplicateEvent() throws Exception {
+        // Arrange
+        LeaderboardUpdateEvent event = LeaderboardUpdateEvent.builder()
+                .eventId("test-event-123")
+                .userId(1L)
+                .sportType("RUNNING")
+                .leaderboardType("total")
+                .operation("ADD")
+                .pointsDelta(100L)
+                .recordId(456L)
+                .timestamp(Instant.now())
+                .build();
+        
+        when(redissonClient.getBucket(anyString())).thenReturn(bucket);
+        when(bucket.setIfAbsent(any(), any())).thenReturn(false); // Already processed
+        
+        // Act & Assert - should handle duplicate gracefully
+        assertDoesNotThrow(() -> consumer.consume(message, event));
+    }
+
+    @Test
+    void testConsumeWithException() throws Exception {
+        // Arrange
+        LeaderboardUpdateEvent event = LeaderboardUpdateEvent.builder()
+                .eventId("test-event-456")
+                .userId(1L)
+                .sportType("RUNNING")
+                .leaderboardType("total")
+                .operation("ADD")
+                .pointsDelta(100L)
+                .recordId(456L)
+                .timestamp(Instant.now())
+                .build();
+        
+        when(redissonClient.getBucket(anyString())).thenReturn(bucket);
+        when(bucket.setIfAbsent(any(), any())).thenReturn(true);
+        
+        // Simulate processing error
+        doThrow(new RuntimeException("Processing failed"))
+                .when(bucket).setIfAbsent(any(), any());
+        
+        // Act & Assert - should throw exception for retry
+        assertThrows(RuntimeException.class, () -> consumer.consume(message, event));
+    }
+}
