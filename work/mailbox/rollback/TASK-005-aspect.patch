+package com.sportverify.leaderboard.aop;
+
+import lombok.extern.slf4j.Slf4j;
+import org.aspectj.lang.ProceedingJoinPoint;
+import org.aspectj.lang.annotation.Around;
+import org.aspectj.lang.annotation.Aspect;
+import org.aspectj.lang.annotation.Pointcut;
+import org.springframework.core.Ordered;
+import org.springframework.core.annotation.Order;
+import org.springframework.stereotype.Component;
+
+/**
+ * 事务日志切面。
+ *
+ * <p>统一记录所有 Spring 事务方法的生命周期日志：</p>
+ * <ul>
+ *   <li><b>事务开始</b>：在目标方法执行前记录；</li>
+ *   <li><b>事务提交成功</b>：方法正常返回后记录；</li>
+ *   <li><b>事务回滚</b>：方法抛出异常后记录（含异常信息）。</li>
+ * </ul>
+ *
+ * <p>通过 {@link Order} 确保在业务逻辑之前执行，便于追踪事务边界。</p>
+ */
+@Slf4j
+@Aspect
+@Component
+@Order(Ordered.HIGHEST_PRECEDENCE + 1)
+public class TransactionLogAspect {
+
+    /**
+     * 切点：匹配 leaderboard-service 下所有带 @Transactional 注解的方法。
+     */
+    @Pointcut("@within(org.springframework.transaction.annotation.Transactional) || " +
+            "@annotation(org.springframework.transaction.annotation.Transactional)")
+    public void transactionPointcut() {
+    }
+
+    /**
+     * 环绕通知：记录事务开始/提交/回滚。
+     *
+     * <p>流程：</p>
+     * <ol>
+     *   <li>记录“事务开始”；</li>
+     *   <li>执行目标方法；</li>
+     *   <li>若正常返回 → 记录“事务提交成功”；</li>
+     *   <li>若抛出异常 → 记录“事务回滚”并重新抛出异常。</li>
+     * </ol>
+     */
+    @Around("transactionPointcut()")
+    public Object logTransaction(ProceedingJoinPoint joinPoint) throws Throwable {
+        String methodName = joinPoint.getSignature().getName();
+        String className = joinPoint.getSignature().getDeclaringTypeName();
+        String fullMethodName = className + "." + methodName;
+
+        log.info("[TRANSACTION] 事务开始：method={}, args={}", fullMethodName, joinPoint.getArgs());
+
+        try {
+            Object result = joinPoint.proceed();
+            log.info("[TRANSACTION] 事务提交成功：method={}", fullMethodName);
+            return result;
+        } catch (Throwable e) {
+            log.warn("[TRANSACTION] 事务回滚：method={}, exception={}", fullMethodName, e.getMessage(), e);
+            throw e;
+        }
+    }
+}
