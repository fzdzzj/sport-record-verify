+package com.sportverify.leaderboard.config;
+
+import org.springframework.context.annotation.Configuration;
+
+/**
+ * 事务配置。
+ *
+ * <p>本类刻意不做任何声明式配置：事务管理器与注解式事务开关都由 Boot 自动装配提供——
+ * {@code DataSourceTransactionManagerAutoConfiguration} 用容器里的 {@code DataSource} 装配
+ * {@code DataSourceTransactionManager}，{@code TransactionAutoConfiguration} 在已有
+ * {@code TransactionManager} 时补上 {@code @EnableTransactionManagement(proxyTargetClass = true)}。
+ * 此前在此手搓 {@code new DataSourceTransactionManager()}（漏 {@code setDataSource}）既让服务起不来，
+ * 又因同名 bean 顶掉上述两处自动装配；裸 {@code @EnableTransactionManagement} 的
+ * {@code proxyTargetClass} 默认 false，遇有接口的 bean 会退化成 JDK 动态代理（按具体类型注入即失败），
+ * 而 Boot 那条走 {@code spring.aop.proxy-target-class}（默认 true），与本服务其他代理口径一致。</p>
+ *
+ * <p>榜单写路径本身按 ADR-0009 保持最终一致，不纳入本地事务，详见
+ * {@link com.sportverify.leaderboard.aop.TransactionLogAspect} 与
+ * {@code docs/adr/0009-事务边界.md}。</p>
+ */
+@Configuration
+public class TransactionConfig {
+}
