{
  "uid": "sport-verify-overview",
  "title": "运动记录校验系统 · 全局监控总览",
  "description": "预置总览面板（可观测性变更，见 ADR-0003）。数据来自 Prometheus 抓取各服务 /actuator/prometheus。覆盖 spec-delta「可视化面板」要求的：服务可用性、HTTP P95/错误率、JVM 堆/GC、连接池，另含 QPS 与线程数。JSON 无法写注释，各面板的指标口径与阈值依据写在面板 description 中。",
  "tags": ["sport-verify", "observability"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务可用性（UP=1 / DOWN=0）",
      "description": "Prometheus 对每个抓取目标的存活标志 up；连续抓取失败 1 分钟会触发 ServiceInstanceDown 告警（见 prometheus/alert-rules.yml）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"gateway-service|user-service|record-service|verify-service\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "orientation": "horizontal",
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"], "fields": "" }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP QPS（每秒请求数，按服务）",
      "description": "http_server_requests_seconds_count 的 1 分钟增速；网关侧可对照 Sentinel 限流基线（5k QPS）观察入口流量。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_requests_seconds_count[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "HTTP P95 延迟（阈值 200ms，审批版 §8.2）",
      "description": "histogram_quantile(0.95, ...) 按 le/job 聚合 5 分钟窗口的 bucket；阈值 0.2s 对齐审批版 §8.2 延迟预算（P95<200ms），越线持续 2 分钟触发 HttpP95LatencyHigh 告警。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_requests_seconds_bucket[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP 5xx 错误率（%）",
      "description": "5xx 请求占比 = 5xx 增速 / 全部请求增速（5 分钟窗口）；持续 2 分钟超 5% 触发 HttpErrorRateHigh 告警。无流量时比值为空，面板留空属正常。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (job) (rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) / sum by (job) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "JVM 堆使用（已用 / 上限，按实例）",
      "description": "jvm_memory_used_bytes / jvm_memory_max_bytes（area=heap）；已用持续超上限 80% 达 5 分钟触发 JvmHeapUsageHigh 告警。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, instance) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{job}} 已用"
        },
        {
          "refId": "B",
          "expr": "sum by (job, instance) (jvm_memory_max_bytes{area=\"heap\"} > 0)",
          "legendFormat": "{{job}} 上限"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM GC 暂停耗时（rate，秒/秒）",
      "description": "jvm_gc_pause_seconds_sum 的 5 分钟增速：数值含义为「每秒花在 GC 上的秒数」，持续接近 0.1 即 GC 压力明显，是堆告警的辅助观察面。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, action) (rate(jvm_gc_pause_seconds_sum[5m]))",
          "legendFormat": "{{job}} {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HikariCP 连接池（活跃 / 空闲 / 等待）",
      "description": "hikaricp_connections_active/idle/pending；pending 持续大于 0 说明连接不够用（压测报告中连接池 10→30 的调优场景可在此持续观察）。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (hikaricp_connections_active)",
          "legendFormat": "{{job}} 活跃"
        },
        {
          "refId": "B",
          "expr": "sum by (job) (hikaricp_connections_idle)",
          "legendFormat": "{{job}} 空闲"
        },
        {
          "refId": "C",
          "expr": "sum by (job) (hikaricp_connections_pending)",
          "legendFormat": "{{job}} 等待"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM 活跃线程数（按服务）",
      "description": "jvm_threads_live_threads；观察 Tomcat 工作线程随并发量增长的趋势，配合压测定位线程池容量问题。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_threads_live_threads",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
