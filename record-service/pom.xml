<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sportverify</groupId>
        <artifactId>sport-verify-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <!-- record-service：运动记录提交/查询 + 点赞（榜单职责已拆分至 leaderboard-service，见 ADR-0005） -->
    <artifactId>sport-verify-record-service</artifactId>
    <name>sport-verify-record-service</name>

    <!-- 覆盖 spring-boot-dependencies 的 snakeyaml 版本：
         ShardingSphere 5.4.1 的 YamlEngine 依赖 snakeyaml 1.x 的 Representer() 无参构造
         （2.x 已移除），故本模块统一降级 1.33（Spring Boot 3.2 的 YAML 解析兼容 1.x） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>1.33</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.sportverify</groupId>
            <artifactId>sport-verify-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sportverify</groupId>
            <artifactId>sport-verify-api</artifactId>
        </dependency>

        <!-- Spring Boot / Cloud 基础 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标导出（可观测性，见 ADR-0003）：把 Micrometer 指标以
             Prometheus 文本格式经 /actuator/prometheus 暴露；版本由父 pom BOM 管理 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Feign 负载均衡：校验回调/好友过滤走 api 契约，Cloud 2023.0.x 需显式声明 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Resilience4j 熔断器：Feign 调 verify-service 的熔断降级（压测变更 spec「熔断降级转人工」）。
             与网关 Sentinel 分工：Sentinel 管入口流量（限流），Resilience4j 管服务间依赖故障（熔断），
             spring.cloud.openfeign.circuitbreaker.enabled 开启后 fallbackFactory 生效 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

        <!-- 数据访问：MyBatis-Plus + MySQL（record_db） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- ShardingSphere-JDBC：track_point 分片（user_id % 16）预留。
             5.4.0 起 spring-boot-starter 模块被移除，运行时构件为 shardingsphere-jdbc-core
             （shardingsphere-jdbc 为 BOM）；骨架阶段仅引入依赖并默认关闭，
             分片配置随校验引擎变更启用（见 ADR-0001） -->
        <dependency>
            <groupId>org.apache.shardingsphere</groupId>
            <artifactId>shardingsphere-jdbc-core</artifactId>
        </dependency>

        <!-- 消息：RocketMQ（记录事件发布 SUBMITTED；榜单事件消费已迁至 leaderboard-service） -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

        <!-- 分布式锁 + Redis 客户端：Redisson（点赞定时 flush 防重 lock:like:flush / 对账防重，
             与好友互加同款 30s 看门狗；starter 自带 spring-data-redis，StringRedisTemplate 计数/成员集/pending 队列复用） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- 本地缓存：Caffeine（二级缓存读侧） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- 本工程父 pom 非 spring-boot-starter-parent，需显式绑定 repackage 到 package 阶段 -->
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
